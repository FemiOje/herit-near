# Copy to .env.local. The explorer, the activity feed and every read work with none of the
# server values set; only the Selfie Check routes (/api/worldid/sign, /api/attest) need them.

# Public: which network and factory the app reads. Both are also the defaults.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_HERIT_FACTORY=herit-near.testnet

# World ID (developer.world.org): an app with Selfie Check enabled, and its relying party.
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
WORLD_SIGNING_KEY=0x...
# production (the World App) or sandbox (the World sandbox testing app)
WORLD_ENVIRONMENT=production

# The attestor: an ed25519 key whose public half the factory hands every new estate, and a salt
# that turns a World nullifier into the commitment stored on chain. Estates opened through
# herit-near.testnet only accept attestations signed with that factory's key.
ATTESTOR_SECRET_KEY=ed25519:...
COMMITMENT_SALT=<32 bytes, hex>
